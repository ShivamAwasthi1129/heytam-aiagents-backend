# ==============================================================================
# Heytam Autonomous AI Workforce Backend — Environment Configuration
# ==============================================================================

# Server Environment
NODE_ENV=production
PORT=4000

# MongoDB Database Connection (MongoDB Atlas or self-hosted)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://admin:password@cluster0.mongodb.net/heytam-ai-agents
MONGODB_DB=heytam-ai-agents

# Authentication Security
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars

# AI Language Model
OPENAI_API_KEY=sk-proj-your-openai-api-key
OPENAI_MODEL=gpt-4o

# CORS & Frontend Origins (Comma-separated for multiple origins)
FRONTEND_URL=https://heytam-onboarding-flow.vercel.app
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://heytam-onboarding-flow.vercel.app
